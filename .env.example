# Copy to .env and fill in. .env is git-ignored.

# --- Postgres (docker-compose) ---
POSTGRES_DB=resolvedesk
POSTGRES_USER=resolvedesk_admin          # superuser: loaders, migrations, eval fixture resets
POSTGRES_PASSWORD=change-me-admin
POSTGRES_PORT=5433                       # host port
STORE_OPS_DB_PASSWORD=change-me-storeops # role used ONLY by the store-ops MCP server
APP_DB_PASSWORD=change-me-app            # role used by FastAPI / LangGraph (no store access)

# Connection strings (host side)
ADMIN_DATABASE_URL=postgresql://resolvedesk_admin:change-me-admin@localhost:5433/resolvedesk
STORE_OPS_DATABASE_URL=postgresql://store_ops:change-me-storeops@localhost:5433/resolvedesk
APP_DATABASE_URL=postgresql://resolvedesk_app:change-me-app@localhost:5433/resolvedesk

# --- LLM: NVIDIA NIM hosted API ---
NVIDIA_API_KEY=
LLM_SMALL_MODEL=meta/llama-3.1-8b-instruct
LLM_LARGE_MODEL=meta/llama-3.3-70b-instruct
EMBEDDING_MODEL=nvidia/nv-embedqa-e5-v5   # 1024 dims; matches app/vectors schema

# --- Store clock: all date rules use this, not the real date ---
STORE_NOW=2018-08-15T12:00:00

# --- Tracing (decide on Day 0) ---
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=resolvedesk
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com
